# Auto-detect text files and normalize line endings for cross-platform consistency
* text=auto

# Enforce LF line endings for all source and config files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env.example text eol=lf
*.gitignore text eol=lf
*.css text eol=lf
*.html text eol=lf

# Preserve CRLF for Windows-specific scripts if any
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files — do not normalize
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
*.lock binary
*.zip binary
*.tar.gz binary

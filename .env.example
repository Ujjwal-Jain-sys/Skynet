# Skynet Environment Variables

Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Engine ---
PORT=3001
NODE_ENV=development

# --- OpenCode / Agent runtime ---
# Set via OpenCode config, not here. Referenced as {env:NAME} in opencode.jsonc.

# --- Database (Postgres) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/skynet

# --- MCP Server credentials (referenced via {env:VAR} in opencode.jsonc) ---
CONTEXT7_API_KEY=your_context7_api_key
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# --- Skynet platform ---
SKYNET_SECRET=your_random_secret_here
SKYNET_DOMAIN=skynet.app

# --- Web UI ---
NEXT_PUBLIC_ENGINE_URL=http://localhost:3001
